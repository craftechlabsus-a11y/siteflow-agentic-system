#!/usr/bin/env bash
set -euo pipefail

COMMIT_MSG_FILE="$1"
FIRST_LINE=$(head -n 1 "$COMMIT_MSG_FILE")

# Allow merge and revert commits generated by git
if [[ "$FIRST_LINE" =~ ^Merge\  ]] || [[ "$FIRST_LINE" =~ ^Revert\  ]]; then
  exit 0
fi

# Conventional Commits regex:
# <type>[optional (<scope>)][optional !]: <description>
PATTERN="^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-zA-Z0-9._/-]+\))?!?: .+"

if [[ ! "$FIRST_LINE" =~ $PATTERN ]]; then
  echo "ERROR: El mensaje de commit no cumple Conventional Commits:"
  echo "  \"$FIRST_LINE\""
  echo ""
  echo "Formato requerido: <tipo>(<alcance opcional>): <descripción>"
  echo "Tipos válidos:"
  echo "  feat:     Nueva funcionalidad (incrementa versión MINOR: 0.x.0)"
  echo "  fix:      Corrección de bug (incrementa versión PATCH: 0.0.x)"
  echo "  perf:     Mejora de rendimiento (incrementa versión PATCH: 0.0.x)"
  echo "  feat!:    Cambio incompatible / BREAKING CHANGE (incrementa MAJOR: x.0.0)"
  echo "  refactor: Refactorización sin cambio funcional"
  echo "  docs:     Documentación"
  echo "  test:     Pruebas"
  echo "  chore:    Mantenimiento / configuración"
  echo "  ci:       Integración continua"
  echo "  build:    Sistema de compilación / dependencias"
  exit 1
fi
